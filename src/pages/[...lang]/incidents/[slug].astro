---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PoliceTape from '../../../components/PoliceTape.astro';
import LevelBadge from '../../../components/LevelBadge.astro';
import Checklist from '../../../components/Checklist.astro';
import VersionChecker from '../../../components/VersionChecker.astro';
import CopyButtons from '../../../components/CopyButtons.astro';
import { getIncidents, isoDate, type Incident } from '../../../lib/incidents';
import { getCveSite } from '../../../lib/cve/site';
import { LEVELS, type Level } from '../../../lib/levels';
import { SITE } from '../../../lib/site';
import { UI, HTML_LANG, LANGS, formatDateIn, localePath, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const all = await getIncidents(lang);
    for (const incident of all) {
      const t = incident.data.date.getTime();
      const related = all
        .filter((x) => x.id !== incident.id)
        .sort((a, b) => Math.abs(a.data.date.getTime() - t) - Math.abs(b.data.date.getTime() - t))
        .slice(0, 3);
      paths.push({ params: { lang: lang === 'en' ? undefined : lang, slug: incident.id }, props: { incident, related, lang } });
    }
  }
  return paths;
}

interface Props {
  incident: Incident;
  related: Incident[];
  lang: Lang;
}
const { incident, related, lang } = Astro.props;
const tx = UI[lang].incident;
const d = incident.data;
// A Chinese page without a translation shows the English original, marked as such.
const untranslated = lang !== 'en' && !incident.translation;
const { Content } = await render(incident.translation ?? incident);
const lvl = UI[lang].levels[d.level as Level];
const when = formatDateIn(lang, d.date, d.dateIsApproximate);
const updated = formatDateIn(lang, d.updated ?? d.date);
const topScore = d.cves.reduce((m, c) => Math.max(m, c.score ?? 0), 0);
const scored = d.cves.filter((c) => c.score);

const facts = [
  { k: tx.disclosed, v: when, note: d.updated ? tx.updated(updated) : tx.publicDate },
  {
    k: tx.severity,
    v: topScore ? `CVSS ${topScore}${scored.length > 1 ? ` × ${scored.filter((c) => c.score === topScore).length}` : ''}` : lvl.name,
    note: d.cves.length ? tx.cveCount(d.cves.length) : tx.noCve,
  },
  { k: tx.splash, v: d.splash, note: d.ecosystems.join(' · ') || d.tags.join(' · ') },
  { k: tx.wild, v: tx.wildValues[d.inTheWild], note: d.inTheWildNote ?? '' },
];
const editUrl = SITE.editUrl((incident.translation ?? incident).filePath ?? '');
const tlColors = ['#FFC93C', '#FF9A3C', '#FF6B2C'];
// CVEs in the 90-day index link to their static page, or to the index dialog when they have none.
const cveSite = await getCveSite();
const cveHref = (id: string) =>
  cveSite.pages.has(id) ? `/cves/${id}/` : cveSite.byId.has(id) ? `${localePath(lang, '/cves/')}?id=${id}` : undefined;
---

<Base title={d.title} description={d.summary} type="article" image={localePath(lang, `/og/${incident.id}.png`)} lang={lang} translated={!untranslated}>
  <div class="hazard hazard--orange" aria-hidden="true"></div>
  <Header variant="inner" lang={lang} />
  <PoliceTape lang={lang} />

  <main id="main">
    {untranslated && <p class="wrap untranslated">{tx.untranslated}</p>}
    <section class="wrap top" lang={untranslated ? 'en' : undefined}>
      <div class="meta rise">
        <LevelBadge level={d.level} lang={lang} />
        <span>{d.tags.join(' · ')}</span>
        <span class="sep" aria-hidden="true">·</span>
        <code>{incident.id}</code>
      </div>
      <h1 class="disp rise">{d.headline ?? d.title}</h1>
      {d.headline && <p class="full rise">{d.title}</p>}
      <p class="sum rise">{d.summary}</p>

      <dl class="facts rise">
        {
          facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd class="fv">{f.v}</dd>
              {f.note && <dd class="fn">{f.note}</dd>}
            </div>
          ))
        }
      </dl>
    </section>

    <div class="wrap layout" lang={untranslated ? 'en' : undefined}>
      <div class="main">
        {
          d.oneLiner && (
            <section>
              <h2 class="disp h">{tx.oneLiner}</h2>
              <p class="oneliner">{d.oneLiner}</p>
            </section>
          )
        }

        <section>
          <h2 class="disp h">{tx.happened}</h2>
          <div class="prose">
            <Content />
          </div>
        </section>

        {
          d.cves.length > 0 && (
            <section>
              <h2 class="disp h">{tx.bowl}</h2>
              <div class="cves">
                {d.cves.map((c) => (
                  <article>
                    <div class="ch">
                      {cveHref(c.id) ? <a href={cveHref(c.id)}><code>{c.id}</code></a> : <code>{c.id}</code>}
                      {c.score && <span class="score">CVSS {c.score}</span>}
                    </div>
                    <h3>{c.name}</h3>
                    <p class="cd">{c.description}</p>
                    {c.plain && (
                      <p class="cp">
                        <b>{tx.plain}</b> {c.plain}
                      </p>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          d.checker ? (
            <VersionChecker {...d.checker} fixed={d.fixed} date={when} lang={lang} />
          ) : (
            d.fixed.length > 0 && (
              <section>
                <h2 class="disp h">{tx.fixed}</h2>
                <div class="plain-table">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">{tx.product}</th>
                        <th scope="col">{tx.safeFrom}</th>
                        <th scope="col">{tx.note}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {d.fixed.map((r) => (
                        <tr>
                          <td>{r.product}</td>
                          <td>{r.version === 'none' ? tx.noFix : <code>{r.version}</code>}</td>
                          <td>{r.status}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )
          )
        }

        {
          d.mitigation && (
            <section>
              <h2 class="disp h">{tx.mitigation}</h2>
              <div class="term">
                <div class="bar">
                  <code>{d.mitigation.file}</code>
                  <button type="button" class="copy" data-copy={d.mitigation.code}>
                    {UI[lang].copy.copy}
                  </button>
                </div>
                <pre tabindex="0">{d.mitigation.code}</pre>
              </div>
              {d.mitigation.note && <p class="mnote">{d.mitigation.note}</p>}
            </section>
          )
        }

        {
          d.timeline.length > 0 && (
            <section>
              <h2 class="disp h">{tx.timeline}</h2>
              <ol class="tl">
                {d.timeline.map((e, i) => (
                  <li>
                    <span class="tdot" style={`background:${tlColors[Math.min(i, tlColors.length - 1)]}`} aria-hidden="true" />
                    <p class="tw">{e.date}</p>
                    <p class="tt">{e.title}</p>
                    {e.body && <p class="tb">{e.body}</p>}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <section>
          <h2 class="disp h">{tx.sources}</h2>
          <p class="lede intro">{tx.sourcesIntro}</p>
          <ul class="sources">
            {
              d.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener">
                    {s.name}
                  </a>
                  {s.primary && <span class="prim">{tx.primary}</span>}
                  {s.says && <span class="says">{s.says}</span>}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <div class="side">
        <Checklist id={incident.id} items={d.checklist} editUrl={editUrl} lang={lang} />
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <div class="wrap">
            <h2 class="disp h">{tx.related}</h2>
            <div class="rel">
              {related.map((r) => {
                const c = LEVELS[r.data.level as Level].color;
                return (
                  <a href={localePath(lang, `/incidents/${r.id}/`)} style={`border-top-color:${c}`}>
                    <span class="badge" style={`background:${c}`}>
                      L{r.data.level} · {formatDateIn(lang, r.data.date, r.data.dateIsApproximate)}
                    </span>
                    <span class="rt">{r.data.headline ?? r.data.title}</span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Footer updated={updated} lang={lang} />
  <CopyButtons lang={lang} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    datePublished: isoDate(d.date),
    dateModified: isoDate(d.updated ?? d.date),
    description: d.summary,
    inLanguage: untranslated ? 'en' : HTML_LANG[lang],
  }).replace(/</g, '\\u003c')} />
</Base>

<style>
  .untranslated {
    margin: 0;
    padding-top: 16px;
    color: var(--muted);
    font-size: 16px;
  }
  .top {
    padding-top: 48px;
    padding-bottom: 40px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    margin-bottom: 20px;
    font-size: 16px;
    color: var(--muted);
  }
  .meta :global(.badge) {
    border-color: var(--text);
    font-size: 16px;
  }
  .meta code {
    font-size: 15px;
  }
  .sep {
    color: var(--faint);
  }
  h1 {
    margin: 0;
    font-size: clamp(38px, 6.4vw, 84px);
    line-height: 1.04;
    letter-spacing: -1.5px;
    max-width: 16em;
    overflow-wrap: break-word;
    animation-delay: 0.06s;
  }
  .full {
    margin: 18px 0 0;
    font-size: 20px;
    font-weight: 700;
    max-width: 40em;
    line-height: 1.4;
  }
  .sum {
    margin: 16px 0 0;
    font-size: 20px;
    color: var(--muted);
    max-width: 40em;
    animation-delay: 0.12s;
  }
  .facts {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    border: 3px solid var(--text);
    animation-delay: 0.18s;
  }
  .facts > div {
    padding: 20px 22px;
    margin: 0;
    border-right: 3px solid var(--text);
    border-bottom: 3px solid var(--text);
    margin-right: -3px;
    margin-bottom: -3px;
  }
  dt {
    font-size: 15px;
    font-weight: 700;
    color: var(--yellow);
  }
  dd {
    margin: 4px 0 0;
  }
  .fv {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
  }
  .fn {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.5;
  }

  .layout {
    padding-top: 24px;
    padding-bottom: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }
  .main {
    flex: 999 1 620px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .side {
    flex: 1 1 360px;
    min-width: 0;
    position: sticky;
    top: 24px;
  }
  .h {
    margin: 0 0 16px;
    font-size: clamp(28px, 4vw, 36px);
    letter-spacing: -0.5px;
    line-height: 1.15;
  }
  .oneliner {
    margin: 0;
    font-size: 19px;
    background: var(--card);
    border: 2px solid var(--line);
    border-left: 10px solid var(--orange);
    padding: 24px 28px;
    max-width: 42em;
  }
  .cves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }
  .cves article {
    background: var(--card);
    border: 2px solid var(--line);
    padding: 24px;
  }
  .ch {
    display: flex;
    justify-content: space-between;
    gap: 8px 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .ch code {
    font-size: 17px;
    font-weight: 700;
    color: var(--yellow);
  }
  .ch a {
    text-decoration-color: color-mix(in srgb, var(--yellow) 45%, transparent);
  }
  .score {
    background: var(--orange);
    color: var(--bg);
    font-weight: 800;
    font-size: 14px;
    padding: 4px 10px;
  }
  .cves h3 {
    margin: 12px 0 6px;
    font-size: 21px;
    line-height: 1.35;
  }
  .cd {
    margin: 0;
    font-size: 17px;
    color: var(--muted);
  }
  .cp {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-size: 16px;
  }
  .cp b {
    color: var(--yellow);
  }
  .plain-table {
    overflow-x: auto;
    border: 2px solid var(--line);
    background: var(--card);
  }
  .plain-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  .plain-table th,
  .plain-table td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .plain-table th {
    color: var(--yellow);
  }
  .plain-table code {
    white-space: nowrap;
  }
  .term {
    background: var(--bg-deep);
    border: 3px solid var(--line);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-bottom: 2px solid var(--line);
  }
  .bar code {
    font-size: 14px;
    color: var(--muted);
  }
  pre {
    margin: 0;
    padding: 20px 22px;
    font-size: 15px;
    line-height: 1.75;
    overflow-x: auto;
  }
  .mnote {
    margin: 12px 0 0;
    font-size: 16px;
    color: var(--muted);
    max-width: 42em;
  }
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 4px solid var(--line);
  }
  .tl li {
    position: relative;
    padding: 0 0 28px 32px;
  }
  .tl li:last-child {
    padding-bottom: 0;
  }
  .tdot {
    position: absolute;
    left: -12px;
    top: 4px;
    width: 20px;
    height: 20px;
    border: 3px solid var(--bg);
  }
  .tw {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--yellow);
  }
  .tt {
    margin: 2px 0 0;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
  }
  .tb {
    margin: 4px 0 0;
    font-size: 17px;
    color: var(--muted);
    max-width: 40em;
  }
  .intro {
    margin: 0 0 16px;
    max-width: 40em;
  }
  .sources {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sources li {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 14px 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
  .sources a {
    font-weight: 700;
    font-size: 17px;
  }
  .prim {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--yellow);
    color: var(--bg);
    padding: 2px 6px;
  }
  .says {
    flex-basis: 100%;
    font-size: 16px;
    color: var(--muted);
  }
  .related {
    border-top: 3px solid var(--line);
  }
  .related .wrap {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .rel {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }
  .rel a {
    display: block;
    text-decoration: none;
    background: var(--card);
    border: 2px solid var(--line);
    border-top: 8px solid;
    padding: 20px 22px;
    transition:
      transform 0.14s ease,
      box-shadow 0.14s ease;
  }
  .rel a:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--orange);
  }
  .rel .badge {
    font-size: 14px;
    padding: 4px 10px;
    border: 0;
  }
  .rt {
    display: block;
    margin-top: 12px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
  }

  @media (max-width: 1023px) {
    .side {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .top {
      padding-top: 28px;
    }
    h1 {
      letter-spacing: -0.8px;
    }
    .full,
    .sum {
      font-size: 17px;
    }
    .facts > div {
      padding: 14px 16px;
    }
    .fv {
      font-size: 18px;
    }
    .layout {
      padding-bottom: 64px;
    }
    .main {
      gap: 48px;
    }
    .oneliner {
      font-size: 17px;
      padding: 18px 18px;
      border-left-width: 6px;
    }
    .cves article {
      padding: 18px;
    }
    pre {
      font-size: 13px;
      padding: 16px;
    }
  }
</style>
