---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IncidentCard from '../../components/IncidentCard.astro';
import Marquee from '../../components/Marquee.astro';
import DevTabs from '../../components/DevTabs.astro';
import CopyButtons from '../../components/CopyButtons.astro';
import Poop from '../../components/Poop.astro';
import { getIncidents, smellIndex, daysSinceLast, isoDate } from '../../lib/incidents';
import { LEVELS, levelList } from '../../lib/levels';
import { SITE } from '../../lib/site';
import { UI, formatDateIn, localePath, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'zh' } }];
}

const lang: Lang = Astro.params.lang === 'zh' ? 'zh' : 'en';
const t = UI[lang].home;
const levelText = UI[lang].levels;
const incidents = await getIncidents(lang);
const latest = incidents[0];
const level = smellIndex(incidents);
const info = { ...LEVELS[level], ...levelText[level] };
const days = daysSinceLast(incidents);
const digits = String(Math.min(days, 99)).padStart(2, '0').split('');
const filters = [0, 3, 4, 5].map((v, i) => ({ v, label: t.filters[i] }));
const levels = levelList.map((l) => ({ ...l, ...levelText[l.n] }));
---

<Base lang={lang}>
  <div class="hazard" aria-hidden="true"></div>
  {
    latest && (
      <div class="banner">
        <span class="live dot" aria-hidden="true" />
        <span>
          <strong>{t.fresh}</strong> {latest.data.headline ?? latest.data.title}
        </span>
        <a href={localePath(lang, `/incidents/${latest.id}/`)}>{t.grab}</a>
      </div>
    )
  }
  <Header lang={lang} />

  <main id="main">
    <section class="wrap hero">
      <div class="copy">
        <p class="pill rise"><span class="live" aria-hidden="true"></span>{t.pill}</p>
        <h1 class="disp rise">Oh <span>Shit.</span></h1>
        <p class="big rise">{t.big}</p>
        <p class="small rise">{t.small}</p>
        <div class="ctas rise">
          <a href="#feed" class="btn btn--primary btn--lg">{t.seeToday}</a>
          <a href="#dev" class="btn btn--ghost btn--lg mono">npx @ohshit/mcp</a>
        </div>
      </div>

      <aside class="sign" aria-label={t.signLabel} data-latest={latest && isoDate(latest.data.date)}>
        <div class="hazard" aria-hidden="true" style="height:14px"></div>
        <div class="sign-body">
          <p class="sl">{t.signTop}</p>
          <div class="digits" data-days>
            {digits.map((d) => <span class="disp">{d}</span>)}
          </div>
          <p class="sl">{t.signBottom}</p>
          <p class="note">{t.signNote}</p>
          <div class="meter">
            <p class="ml">{t.index}</p>
            <div class="poops">
              {
                [1, 2, 3, 4, 5].map((n) => (
                  <Poop
                    size={44}
                    fill={n <= level ? info.color : '#E3D5BC'}
                    stroke="#1A120B"
                    class={n <= level ? 'bounce' : ''}
                    style={`animation-delay:${n * 0.12}s`}
                  />
                ))
              }
            </div>
            <p class="disp mlevel">L{level} · {info.name}</p>
            <p class="madvice">{info.advice} <span class="mwhy">{t.indexWhy}</span></p>
          </div>
        </div>
      </aside>
    </section>

    <Marquee lang={lang} />

    <section id="feed" class="wrap feed">
      <div class="feed-head">
        <div>
          <p class="kicker">GET /api/v1/incidents.json</p>
          <h2 class="disp section-title">{t.feedTitle}</h2>
          <p class="lede">{t.feedLede}</p>
        </div>
        <div role="group" aria-label={t.filterLabel} class="filters">
          {
            filters.map((f, i) => (
              <button type="button" class="chip" data-min={f.v} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="cards" data-cards>
        {incidents.map((i) => <IncidentCard incident={i} lang={lang} />)}
      </div>
      <p class="empty" data-empty hidden>{t.empty}</p>
      <p class="count">
        {t.count(incidents.length, incidents.length ? formatDateIn(lang, incidents.at(-1)!.data.date) : '—')}
        {' '}<a href={`${SITE.repo}/tree/main/incidents`}>{t.raw}</a>
      </p>
    </section>

    <section id="levels" class="wrap levels">
      <p class="kicker">{t.scaleKicker}</p>
      <h2 class="disp section-title">{t.scaleTitle}</h2>
      <p class="lede">{t.scaleLede}</p>
      <div class="scale">
        {
          levels.map((l) => (
            <div class={`lvl${l.n === level ? ' now' : ''}`} style={`background:${l.color}`}>
              <div class="lt">
                <span class="disp ln">L{l.n}</span>
                <Poop size={40} class="bounce" style={`animation-delay:${l.n * 0.15}s;animation-duration:${2.2 - l.n * 0.3}s`} />
              </div>
              <span class="lname">{l.name}</span>
              <span class="ldesc">{l.desc}</span>
              <span class="lwhen">{l.when}</span>
            </div>
          ))
        }
      </div>
    </section>

    <DevTabs exampleId={latest?.id ?? 'php2shell'} site={String(Astro.site)} lang={lang} />

    <section id="submit" class="wrap submit">
      <div class="box yellow">
        <h2 class="disp" set:html={t.subTitle} />
        <p>{t.subText}</p>
        <div class="ctas">
          <a class="btn dark" href={localePath(lang, '/rss.xml')}>{t.subRss}</a>
          <a class="btn outline" href={SITE.repo}>{t.subGithub}</a>
        </div>
      </div>
      <div class="box dashed">
        <h2 class="disp">{t.newTitle}</h2>
        <p>{t.newText}</p>
        <div class="ctas">
          <a class="btn btn--primary btn--lg" href={SITE.reportUrl}>{t.newReport}</a>
          <a class="btn btn--ghost btn--lg" href={`${SITE.repo}/blob/main/CONTRIBUTING.md`}>{t.newHow}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
  <CopyButtons lang={lang} />
</Base>

<script>
  // Keep the counter honest between builds.
  const sign = document.querySelector<HTMLElement>('[data-latest]');
  if (sign?.dataset.latest) {
    // Count calendar days in the viewer's time zone, so an incident dated today reads 00 everywhere.
    const [y, m, d] = sign.dataset.latest.slice(0, 10).split('-').map(Number);
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    const days = Math.max(0, Math.round((today - Date.UTC(y, m - 1, d)) / 864e5));
    const el = sign.querySelector('[data-days]')!;
    const ds = String(Math.min(days, 99)).padStart(2, '0').split('');
    el.querySelectorAll('span').forEach((s, i) => (s.textContent = ds[i]));
  }

  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters .chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cards] > [data-level]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const min = Number(c.dataset.min);
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      let shown = 0;
      cards.forEach((card) => {
        const on = Number(card.dataset.level) >= min;
        card.hidden = !on;
        if (on) shown++;
      });
      empty.hidden = shown > 0;
    }),
  );
</script>

<style>
  .banner {
    background: var(--yellow);
    color: var(--bg);
    font-weight: 600;
    font-size: 16px;
    padding: 10px 16px;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px 10px;
    flex-wrap: wrap;
    line-height: 1.45;
  }
  .banner a {
    color: var(--bg);
    font-weight: 700;
  }
  .banner .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #b3290a;
    display: inline-block;
  }
  .hero {
    padding-top: 56px;
    padding-bottom: 88px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .copy {
    flex: 999 1 560px;
    min-width: 0;
  }
  .pill {
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--yellow);
    background: #2e2015;
    border: 1px solid var(--line);
    padding: 6px 14px;
    border-radius: 999px;
    line-height: 1.4;
  }
  .pill .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    flex: 0 0 auto;
  }
  h1 {
    margin: 0;
    font-size: clamp(64px, 10vw, 152px);
    line-height: 0.9;
    letter-spacing: -2px;
    animation-delay: 0.08s;
  }
  h1 span {
    color: var(--yellow);
  }
  .big {
    margin: 28px 0 0;
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    max-width: 22em;
    line-height: 1.3;
    letter-spacing: -0.3px;
    animation-delay: 0.16s;
  }
  .small {
    margin: 18px 0 0;
    font-size: 19px;
    color: var(--muted);
    max-width: 34em;
    animation-delay: 0.24s;
  }
  .ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    animation-delay: 0.32s;
  }
  .hero .btn--primary {
    border: 3px solid var(--text);
    box-shadow: 6px 6px 0 var(--orange);
  }
  .mono {
    font-family: var(--mono);
    font-size: 17px;
  }
  .sign {
    flex: 1 1 340px;
    max-width: 400px;
    background: var(--paper);
    color: var(--bg);
    border: 4px solid var(--bg);
    box-shadow: 10px 10px 0 var(--yellow);
    transform: rotate(1.5deg);
  }
  .sign-body {
    padding: 24px 28px 28px;
    text-align: center;
  }
  .sl {
    margin: 0;
    font-weight: 700;
    font-size: 18px;
  }
  .digits {
    margin: 12px auto;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .digits span {
    background: var(--bg);
    color: var(--yellow);
    font-size: 92px;
    line-height: 1;
    padding: 8px 18px;
  }
  .note {
    margin: 10px 0 0;
    font-size: 15px;
    color: #5a4330;
  }
  .meter {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 3px dashed var(--bg);
    text-align: left;
  }
  .ml {
    margin: 0 0 8px;
    font-weight: 700;
    font-size: 16px;
  }
  .poops {
    display: flex;
    gap: 6px;
    align-items: flex-end;
  }
  .mlevel {
    margin: 10px 0 0;
    font-size: 24px;
    line-height: 1.2;
  }
  .madvice {
    margin: 4px 0 0;
    font-size: 16px;
    color: var(--paper-ink);
  }
  .mwhy {
    display: block;
    font-size: 14px;
    color: #5a4330;
  }

  .feed {
    padding-top: 104px;
    padding-bottom: 48px;
  }
  .feed-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 36px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .empty,
  .count {
    margin: 32px 0 0;
    text-align: center;
    color: var(--muted);
  }
  .count a {
    font-weight: 700;
  }

  .levels {
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .scale {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 16px;
  }
  .lvl {
    color: var(--bg);
    border: 3px solid var(--text);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 270px;
  }
  .lvl.now {
    outline: 4px solid var(--yellow);
    outline-offset: 4px;
  }
  .lt {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .ln {
    font-size: 44px;
    line-height: 1;
  }
  .lname {
    font-weight: 800;
    font-size: 22px;
    line-height: 1.2;
  }
  .ldesc {
    font-size: 16px;
    line-height: 1.55;
  }
  .lwhen {
    margin-top: auto;
    padding-top: 12px;
    border-top: 2px solid var(--bg);
    font-size: 15px;
    font-weight: 700;
  }

  .submit {
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }
  .box {
    flex: 1 1 460px;
    min-width: 0;
    padding: 36px;
  }
  .box h2 {
    margin: 0;
    font-size: clamp(30px, 5vw, 40px);
    line-height: 1.1;
  }
  .box p {
    margin: 12px 0 0;
  }
  .box .ctas {
    margin-top: 24px;
  }
  .yellow {
    background: var(--yellow);
    color: var(--bg);
    border: 4px solid var(--text);
  }
  .yellow .btn {
    min-height: 56px;
    font-size: 18px;
    border: 3px solid var(--bg);
  }
  .yellow .dark {
    background: var(--bg);
    color: var(--yellow);
  }
  .yellow .outline {
    background: transparent;
    color: var(--bg);
  }
  .yellow .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--bg);
  }
  .dashed {
    border: 4px dashed var(--yellow);
  }
  .dashed h2 {
    color: var(--yellow);
  }
  .dashed p {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 64px;
      gap: 40px;
    }
    .pill {
      font-size: 14px;
      border-radius: 16px;
    }
    .small {
      font-size: 17px;
    }
    .ctas .btn {
      flex: 1 1 100%;
    }
    .sign {
      transform: none;
      max-width: none;
      box-shadow: 6px 6px 0 var(--yellow);
    }
    .digits span {
      font-size: 72px;
    }
    .feed {
      padding-top: 64px;
    }
    .filters {
      gap: 6px;
    }
    .filters .chip {
      font-size: 15px;
      padding: 0 12px;
    }
    .levels {
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .lvl {
      min-height: 0;
    }
    .submit {
      padding-top: 56px;
      padding-bottom: 56px;
    }
    .box {
      padding: 24px 20px;
    }
  }
</style>
