---
// Static pages for the CVEs people search for by id: known exploited, critical, or cited by an incident.
// English only; the Chinese index opens the same record in its dialog.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getIncidents } from '../../lib/incidents';
import { getCveSite, productLine, scoreSourceLabel, type SiteCve } from '../../lib/cve/site';
import { severity, WINDOW_DAYS } from '../../lib/cve/data';

export async function getStaticPaths() {
  const site = await getCveSite();
  return [...site.pages].map((id) => ({ params: { id }, props: { r: site.byId.get(id)! } }));
}
interface Props { r: SiteCve }
const { r } = Astro.props;
const site = await getCveSite();
const titles = new Map((await getIncidents('en')).map((i) => [i.id, i.data.title]));
const incidents = (site.cited.get(r.id) ?? []).map((slug) => ({ title: titles.get(slug) ?? slug, url: `/incidents/${slug}/` }));

const clip = (s: string, max: number) => (s.length <= max ? s : `${s.slice(0, s.lastIndexOf(' ', max - 1) > max * 0.6 ? s.lastIndexOf(' ', max - 1) : max - 1)}…`);
const products = productLine(r.products, 1);
const subject = products || clip(r.description, 60);
const score = r.score === null ? null : r.score.toFixed(1);
const sev = severity(r.score);
const sevName = { critical: 'Critical', high: 'High', medium: 'Medium', low: 'Low', none: 'None', unknown: 'Unscored' }[sev];
const title = `${r.id}: ${subject}${score ? ` (CVSS ${score})` : ''}`;
const description = clip(`${r.id}${r.kev ? ', in CISA KEV' : ''}${score ? `, CVSS ${score}` : ''}. ${r.description}`, 158);
const date = (s: string) => new Date(s).toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
const cweLink = (w: string) => (/^CWE-\d+$/.test(w) ? `https://cwe.mitre.org/data/definitions/${w.slice(4)}.html` : undefined);
const references = [`https://www.cve.org/CVERecord?id=${r.id}`, `https://nvd.nist.gov/vuln/detail/${r.id}`, ...r.references]
  .flatMap((u) => { try { const url = new URL(u); return ['http:', 'https:'].includes(url.protocol) ? [url] : []; } catch { return []; } })
  .slice(0, 40);
const allProducts = productLine(r.products, 30);
const related = site.related(r.id).map((o) => ({ id: o.id, products: productLine(o.products, 1), score: o.score === null ? '—' : o.score.toFixed(1), sev: severity(o.score), kev: o.kev }));

const pageUrl = new URL(`/cves/${r.id}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'TechArticle', headline: title, description, url: pageUrl, inLanguage: 'en',
    datePublished: r.published, dateModified: r.modified,
    about: { '@type': 'Thing', name: r.id, identifier: r.id, sameAs: `https://www.cve.org/CVERecord?id=${r.id}` },
    isBasedOn: `https://nvd.nist.gov/vuln/detail/${r.id}`,
    publisher: { '@type': 'Organization', name: 'OhShit', url: new URL('/', Astro.site).href },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'OhShit!', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'CVE Index', item: new URL('/cves/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: r.id, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} type="article" image="/og/cves.png" translated={false}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
  <div class="hazard" aria-hidden="true"></div>
  <Header variant="inner" currentLabel={r.id} parents={[{ label: 'CVE Index', href: '/cves/' }]} switchHref={`/zh/cves/?id=${r.id}`} />
  <main id="main" class="wrap cve-page">
    <p class="kicker">// CVE · PUBLISHED {r.published.slice(0, 10)}</p>
    <h1 class="disp">{r.id}</h1>
    {products && <p class="lede mono">{productLine(r.products, 3)}</p>}
    <div class="badges">
      <span class={`cve-badge score sev-${sev}`}>{score ? `${score} · CVSS ${r.cvssVersion ?? ''}`.trim() : 'Unscored'}</span>
      <span class="sev-name">{sevName}</span>
      {r.kev && <span class="cve-badge kev">CISA KEV</span>}
    </div>
    {r.kev && <p class="kev-note">CISA lists this CVE as exploited in the wild. Patch it before anything rated by score alone.</p>}

    <div class="layout">
      <div class="content">
        <section>
          <h2>Description</h2>
          <p class="description">{r.description}</p>
        </section>

        {incidents.length > 0 && (
          <section>
            <h2>OhShit! incidents</h2>
            <ul class="incidents">{incidents.map((i) => <li><a href={i.url}>{i.title} →</a></li>)}</ul>
          </section>
        )}

        <section>
          <h2>References</h2>
          <ul class="refs">{references.map((u) => <li><a href={u.href} rel="noopener noreferrer nofollow">{u.hostname}{u.pathname} ↗</a></li>)}</ul>
        </section>

        {related.length > 0 && (
          <section>
            <h2>Related CVEs</h2>
            <ul class="related">
              {related.map((o) => (
                <li>
                  <a class="mono" href={`/cves/${o.id}/`}>{o.id}</a>
                  <span class="related-products">{o.products}</span>
                  {o.kev && <span class="cve-badge kev">KEV</span>}
                  <span class={`cve-badge score sev-${o.sev}`}><span class="sr-only">CVSS </span>{o.score}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="back"><a href="/cves/">← CVE Index: search every CVE from the last {WINDOW_DAYS} days</a></p>
        <p class="attribution">This product uses the NVD API but is not endorsed or certified by the NVD. CVSS scores do not establish exploitation.</p>
      </div>
      <aside class="facts" aria-labelledby="facts-title">
        <h2 id="facts-title">Details</h2>
        <dl>
          <dt>Products</dt><dd>{allProducts || '—'}</dd>
          <dt>Published</dt><dd><time datetime={r.published}>{date(r.published)}</time></dd>
          <dt>Modified</dt><dd><time datetime={r.modified}>{date(r.modified)}</time></dd>
          <dt>CVSS</dt><dd>{score ? `${score} ${sevName}${r.cvssVersion ? ` (v${r.cvssVersion})` : ''}` : '—'}</dd>
          {r.vector && <><dt>Vector</dt><dd class="mono vector">{r.vector}</dd></>}
          <dt>Score source</dt><dd>{scoreSourceLabel(r.scoreSource)}</dd>
          <dt>CWE</dt><dd>{r.weaknesses.length ? r.weaknesses.map((w, i) => <>{i > 0 && ', '}{cweLink(w) ? <a href={cweLink(w)} rel="noopener noreferrer">{w}</a> : w}</>) : '—'}</dd>
          <dt>Record status</dt><dd>{r.status}</dd>
        </dl>
      </aside>
    </div>
  </main>
  <Footer legal="Code is MIT licensed. Vulnerability data is provided by NVD and the CVE Program." />
</Base>

<style>
  .cve-page { padding-top: 44px; padding-bottom: 80px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 0 64px; align-items: start; }
  .content { min-width: 0; }
  .facts { position: sticky; top: 24px; margin-top: 36px; }
  h1 { margin: 10px 0 8px; font-size: clamp(36px, 7vw, 64px); line-height: 1.1; letter-spacing: -2px; overflow-wrap: anywhere; }
  .lede, .kev-note { max-width: 880px; }
  .lede { margin: 0 0 18px; color: var(--text); font-size: 15px; }
  .badges { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .score { font-size: 17px; padding: 5px 10px; }
  .sev-name { color: var(--muted); font-size: 14px; }
  .kev-note { margin: 18px 0 0; padding: 12px 16px; border-left: 3px solid var(--orange); background: var(--card); font-size: 16px; }
  section { margin-top: 36px; }
  h2 { font-size: 20px; margin: 0 0 12px; }
  .description { margin: 0; font-size: 17px; overflow-wrap: anywhere; }
  .incidents { margin: 0; padding-left: 20px; }
  dl { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 10px 16px; margin: 0; font-size: 14px; border-top: 1px solid var(--line); padding-top: 16px; }
  dt { color: var(--muted); }
  dd { margin: 0; overflow-wrap: anywhere; }
  .vector { font-size: 13px; }
  .refs { margin: 0; padding-left: 20px; font-size: 14px; }
  .refs li { padding-bottom: 6px; overflow-wrap: anywhere; }
  .related { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .related li { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .related a { font-weight: 600; white-space: nowrap; }
  .related-products { flex: 1; min-width: 0; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .related .score { margin-left: auto; }
  .back { margin-top: 44px; font-weight: 600; }
  .attribution { font-size: 12px; color: var(--muted); }
  @media (max-width: 1023px) {
    .layout { display: block; }
    .facts { position: static; }
  }
  @media (max-width: 760px) {
    .cve-page { padding-top: 24px; }
    h1 { letter-spacing: -1px; }
    dl { grid-template-columns: 104px minmax(0, 1fr); }
  }
</style>
