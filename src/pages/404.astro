---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI } from '../lib/i18n';
const t = UI.en.notFound;
const zh = UI.zh.notFound;
---

<Base title="Flushed">
  <div class="hazard" aria-hidden="true"></div>
  <Header />
  <main id="main" class="wrap nf">
    <p class="kicker">404</p>
    <h1 class="disp">{t.heading}</h1>
    <p class="lede">{t.lede}</p>
    <a class="btn btn--primary btn--lg" href="/#feed">{t.back}</a>
    <p class="zh" lang="zh-CN">{zh.heading}{zh.lede} <a href="/zh/#feed">{zh.back} →</a></p>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    padding-top: 80px;
    padding-bottom: 120px;
  }
  h1 {
    margin: 8px 0 0;
    font-size: clamp(48px, 9vw, 120px);
    line-height: 1;
  }
  .zh {
    margin-top: 40px;
    color: var(--muted);
    font-size: 17px;
  }
  .btn {
    margin-top: 32px;
  }
</style>
