---
import { SITE } from '../lib/site';
import { UI, localePath, type Lang } from '../lib/i18n';
interface Props {
  exampleId: string;
  site: string;
  lang?: Lang;
}
const { exampleId, site, lang = 'en' } = Astro.props;
const T = UI[lang].dev;
const origin = site.replace(/\/$/, '');
const feed = `${origin}${localePath(lang, '/rss.xml')}`;

const TABS = [
  {
    key: 'mcp',
    name: T.tabNames[0],
    blurb: T.mcpBlurb,
    file: 'claude_desktop_config.json',
    code: `{
  "mcpServers": {
    "ohshit": {
      "command": "npx",
      "args": ["-y", "@ohshit/mcp"]
    }
  }
}`,
    points: [
      { k: 'list_incidents', v: T.mcpPoints[0] },
      { k: 'get_incident', v: T.mcpPoints[1] },
      { k: 'smell_index', v: T.mcpPoints[2] },
    ],
  },
  {
    key: 'api',
    name: T.tabNames[1],
    blurb: T.apiBlurb,
    file: 'terminal',
    code: `$ curl -s ${origin}/api/v1/incidents.json \\
    | jq '.data[] | select(.level >= 4) | {id, level, title}'

{
  "id": "${exampleId}",
  "level": 5,
  "title": "PHP2Shell: …"
}

$ curl -s ${origin}/api/v1/smell-index.json
{ "level": 5, "level_name": "shitstorm", "days_since_last": 0 }`,
    points: [
      { k: 'GET /api/v1/incidents.json', v: T.apiPoints[0] },
      { k: 'GET /api/v1/incidents/{id}.json', v: T.apiPoints[1] },
      { k: 'GET /api/v1/smell-index.json', v: T.apiPoints[2] },
    ],
  },
  {
    key: 'rss',
    name: T.tabNames[2],
    blurb: T.rssBlurb,
    file: 'Slack',
    code: T.rssCode(feed),
    points: T.rssPoints,
  },
];
---

<section id="dev" class="dev">
  <div class="hazard" aria-hidden="true" style="height:14px"></div>
  <div class="wrap grid">
    <div class="left">
      <p class="kick">{T.kick}</p>
      <h2 class="disp title" set:html={T.title} />
      <p class="intro">
        {T.intro}{lang === 'en' && ' '}<a href={SITE.repo}>{T.openSource}</a>{lang === 'zh' ? '。' : '.'}
      </p>
      <div role="tablist" aria-label={T.tablist} class="tabs">
        {
          TABS.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.key}`}
              aria-controls={`panel-${t.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
            >
              <span class="disp tname">{t.name}</span>
              <span class="tblurb">{t.blurb}</span>
            </button>
          ))
        }
      </div>
    </div>
    <div class="right">
      {
        TABS.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} hidden={i !== 0}>
            <div class="term">
              <div class="bar">
                <span class="file">{t.file}</span>
                <button type="button" class="copy" data-copy={t.code}>
                  {UI[lang].copy.copy}
                </button>
              </div>
              <pre tabindex="0">{t.code}</pre>
            </div>
            <div class="points">
              {t.points.map((p) => (
                <div>
                  <code>{p.k}</code>
                  <p>{p.v}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#dev [role="tab"]'));
  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const next = tabs[(i + d + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>

<style>
  .dev {
    background: var(--paper);
    color: var(--bg);
    border-top: 4px solid var(--bg);
    margin-top: 48px;
  }
  .dev a {
    color: #8a3a10;
  }
  .grid {
    padding-top: 88px;
    padding-bottom: 88px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }
  .left {
    flex: 1 1 340px;
    min-width: 0;
  }
  .right {
    flex: 999 1 560px;
    min-width: 0;
  }
  .kick {
    margin: 0;
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    color: #8a3a10;
  }
  .title {
    margin: 6px 0 16px;
    font-size: clamp(38px, 6vw, 52px);
    line-height: 1.05;
    letter-spacing: -1px;
  }
  .intro {
    margin: 0 0 28px;
    color: var(--paper-ink);
  }
  .tabs {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tab {
    text-align: left;
    font: inherit;
    color: var(--bg);
    padding: 16px 20px;
    min-height: 44px;
    border: 3px solid var(--bg);
    background: #fff;
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .tab:hover {
    transform: translateY(-2px);
  }
  .tab[aria-selected='true'] {
    background: var(--yellow);
    box-shadow: 6px 6px 0 var(--bg);
  }
  .tname {
    display: block;
    font-size: 22px;
  }
  .tblurb {
    display: block;
    font-size: 16px;
    margin-top: 2px;
    line-height: 1.45;
  }
  .term {
    background: var(--bg);
    color: var(--text);
    border: 4px solid var(--bg);
    box-shadow: 12px 12px 0 var(--orange);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px;
    border-bottom: 2px solid var(--line);
  }
  .file {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  pre {
    margin: 0;
    padding: 24px 26px 28px;
    font-size: 15px;
    line-height: 1.75;
    overflow-x: auto;
  }
  .points {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }
  .points > div {
    border: 3px solid var(--bg);
    padding: 16px 18px;
    background: #fff;
  }
  .points code {
    font-weight: 700;
    font-size: 15px;
    color: #8a3a10;
    overflow-wrap: anywhere;
  }
  .points p {
    margin: 6px 0 0;
    font-size: 16px;
    color: var(--card);
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .grid {
      padding-top: 56px;
      padding-bottom: 64px;
    }
    .term {
      box-shadow: 6px 6px 0 var(--orange);
    }
    pre {
      padding: 18px 16px;
      font-size: 13px;
    }
  }
</style>
