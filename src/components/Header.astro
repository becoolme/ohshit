---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
import { UI, HTML_LANG, localePath, stripLang, type Lang } from '../lib/i18n';
interface Props {
  variant?: 'home' | 'inner';
  lang?: Lang;
  currentLabel?: string;
  /** Crumbs between "Back to the feed" and the current page. */
  parents?: { label: string; href: string }[];
  /** Where the language switch goes when this page has no counterpart in the other language. */
  switchHref?: string;
}
const { variant = 'home', lang = 'en', currentLabel, parents = [] } = Astro.props;
const t = UI[lang].header;
const other: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref = Astro.props.switchHref ?? localePath(other, stripLang(Astro.url.pathname));
const p = (path: string) => localePath(lang, path);
const cvesLabel = lang === 'zh' ? 'CVE 索引' : 'CVE Index';
const onCves = stripLang(Astro.url.pathname).startsWith('/cves/');
---

<header class="wrap header">
  <Logo href={p('/')} label={t.home} />
  <div class="end">
    {variant === 'home' && <a href={p('/rss.xml')} class="btn btn--primary rss-m">RSS</a>}
    {variant === 'inner' && !onCves && <a href={p('/cves/')} class="end-link">{cvesLabel}</a>}
    <a href={switchHref} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]} aria-label={t.switchLabel} class="lang">{t.switchTo}</a>
  </div>
  {
    variant === 'home' ? (
      <nav aria-label={t.nav} class="nav">
        <a href={p('/#feed')}>{t.feed}</a>
        <a href={p('/cves/')}>{cvesLabel}</a>
        <a href={p('/#levels')}>{t.scale}</a>
        <a href={p('/#dev')}>{t.dev}</a>
        <a href={SITE.reportUrl}>{t.report}</a>
        <a href={p('/rss.xml')} class="btn btn--primary rss-d">{t.subscribe}</a>
      </nav>
    ) : (
      <nav aria-label={t.crumbs} class="crumbs">
        <a href={p('/#feed')}>{t.back}</a>
        <span aria-hidden="true">/</span>
        {parents.map((c) => (
          <>
            <a href={c.href}>{c.label}</a>
            <span aria-hidden="true">/</span>
          </>
        ))}
        <span aria-current="page">{currentLabel ?? t.here}</span>
      </nav>
    )
  }
</header>

<style>
  .header {
    padding-top: 20px;
    padding-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }
  .nav,
  .crumbs {
    order: 2;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    font-weight: 600;
    font-size: 16px;
  }
  .nav a:not(.btn),
  .crumbs a {
    color: var(--text);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav a:not(.btn):hover,
  .crumbs a:hover {
    color: var(--yellow);
  }
  .end {
    order: 3;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    min-height: 40px;
    min-width: 44px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--line);
    color: var(--text);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .end-link {
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 6px;
  }
  .end-link:hover {
    color: var(--yellow);
  }
  .lang:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }
  .rss-m {
    display: none;
  }
  @media (max-width: 760px) {
    .rss-d {
      display: none;
    }
    .end {
      order: 1;
    }
    .rss-m {
      display: inline-flex;
      min-height: 40px;
      padding: 0 14px;
      font-size: 15px;
      box-shadow: 3px 3px 0 var(--orange);
    }
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
  }
  .crumbs span[aria-hidden] {
    color: var(--faint);
  }
  .crumbs span:last-child {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .header {
      padding-top: 12px;
      padding-bottom: 8px;
    }
    /* One swipeable row of links; RSS moves up beside the logo. */
    .nav {
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 4px;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 0 18px;
      font-size: 15px;
      white-space: nowrap;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
