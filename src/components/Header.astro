---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
interface Props {
  variant?: 'home' | 'inner';
}
const { variant = 'home' } = Astro.props;
---

<header class="wrap header">
  <Logo />
  {variant === 'home' && <a href="/rss.xml" class="btn btn--primary rss-m">RSS</a>}
  {
    variant === 'home' ? (
      <nav aria-label="Main" class="nav">
        <a href="/#feed">Feed</a>
        <a href="/#levels">The Scale</a>
        <a href="/#dev">MCP / API / RSS</a>
        <a href={SITE.reportUrl}>Report a Turd</a>
        <a href="/rss.xml" class="btn btn--primary rss-d">Subscribe to the Smell</a>
      </nav>
    ) : (
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/#feed">← Back to the feed</a>
        <span aria-hidden="true">/</span>
        <span>Crime scene</span>
      </nav>
    )
  }
</header>

<style>
  .header {
    padding-top: 20px;
    padding-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    font-weight: 600;
    font-size: 16px;
  }
  .nav a:not(.btn),
  .crumbs a {
    color: var(--text);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav a:not(.btn):hover,
  .crumbs a:hover {
    color: var(--yellow);
  }
  .rss-m {
    display: none;
  }
  @media (max-width: 760px) {
    .rss-d {
      display: none;
    }
    .rss-m {
      display: inline-flex;
      min-height: 40px;
      padding: 0 14px;
      font-size: 15px;
      box-shadow: 3px 3px 0 var(--orange);
    }
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
  }
  .crumbs span:first-of-type {
    color: var(--faint);
  }
  .crumbs span:last-child {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .header {
      padding-top: 12px;
      padding-bottom: 8px;
    }
    /* One swipeable row of links; RSS moves up beside the logo. */
    .nav {
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 4px;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 0 18px;
      font-size: 15px;
      white-space: nowrap;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
