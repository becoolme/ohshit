---
import Poop from './Poop.astro';
interface Row {
  product: string;
  branch?: string;
  version: string;
  status?: string;
}
interface Props {
  runtime: string;
  command: string;
  examples: string[];
  fixed: Row[];
  date: string;
}
const { runtime, command, examples, fixed, date } = Astro.props;
const branches = fixed.filter((r) => r.branch).map((r) => ({ branch: r.branch!, version: r.version }));
---

<section id="check" class="checker" data-branches={JSON.stringify(branches)} data-runtime={runtime}>
  <h2 class="disp">Are you standing in it?</h2>
  <p class="how">
    Run <code>{command}</code> on each box, then type the version or pick the closest match.
  </p>
  <form class="row" data-form>
    <label for="ver" class="sr-only">Your {runtime} version</label>
    <input id="ver" name="ver" inputmode="decimal" autocomplete="off" placeholder={`e.g. ${examples[0]}`} />
    <button type="submit">Sniff it</button>
  </form>
  <div role="group" aria-label={`Example ${runtime} versions`} class="chips">
    {
      examples.map((v) => (
        <button type="button" data-v={v} aria-pressed="false">
          {runtime} {v}
        </button>
      ))
    }
  </div>
  <div class="verdict" role="status" data-verdict hidden>
    <Poop size={40} fill="currentColor" stroke="#1A120B" class="ico" />
    <div>
      <p class="disp vt" data-title></p>
      <p class="vb" data-body></p>
    </div>
  </div>
  <div class="tbl">
    <table>
      <caption>Fixed versions ({date})</caption>
      <thead>
        <tr><th scope="col">Branch</th><th scope="col">Safe from</th><th scope="col">Status</th></tr>
      </thead>
      <tbody>
        {
          fixed.map((r) => (
            <tr>
              <td>{r.product}</td>
              <td><code>{r.version}</code></td>
              <td>{r.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  import { checkVersion, type FixedBranch } from '../lib/versions';

  for (const root of document.querySelectorAll<HTMLElement>('.checker[data-branches]')) {
    const branches: FixedBranch[] = JSON.parse(root.dataset.branches!);
    const rt = root.dataset.runtime!;
    const out = root.querySelector<HTMLElement>('[data-verdict]')!;
    const input = root.querySelector<HTMLInputElement>('input')!;
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-v]'));

    const judge = (raw: string) => {
      const result = checkVersion(raw, branches, rt);
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.v === raw)));
      let title: string, body: string;
      if (result.kind === 'invalid' || result.kind === 'incomplete') {
        title = 'Enter a full version.';
        body = input.placeholder;
      } else if (result.kind === 'unknown') {
        title = 'Not covered by this advisory.';
        body = /[a-z]/i.test(raw.replace(/^\s*v/i, ''))
          ? 'Pre-release builds aren’t covered. Check the vendor advisory, or move to a stable release.'
          : 'Check the vendor advisory for this version.';
      } else if (result.kind === 'eol') {
        title = 'No official patch for this branch.';
        body = 'Upgrade to a patched branch or check your support vendor’s backport.';
      } else if (result.kind === 'ok') {
        title = 'Clean seat. You’re patched.';
        body = `${rt} ${result.version} meets this advisory’s fixed-version threshold. Still check every server, container image and CI runner, not just this one.`;
      } else {
        title = 'You’re standing in it.';
        body = `Upgrade to ${result.fixed} or later.`;
      }
      out.dataset.kind =
        result.kind === 'invalid' || result.kind === 'incomplete' ? 'hint'
          : result.kind === 'ok' || result.kind === 'bad' ? result.kind : 'eol';
      input.setAttribute('aria-invalid', String(result.kind === 'invalid' || result.kind === 'incomplete'));
      out.querySelector('[data-title]')!.textContent = title;
      out.querySelector('[data-body]')!.textContent = body;
      out.hidden = false;
    };
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        input.value = c.dataset.v!;
        judge(c.dataset.v!);
      }),
    );
    root.querySelector('[data-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      judge(input.value);
    });
  }
</script>

<style>
  .checker {
    background: var(--paper);
    color: var(--bg);
    border: 4px solid var(--bg);
    box-shadow: 10px 10px 0 var(--yellow);
    padding: 32px;
  }
  h2 {
    margin: 0;
    font-size: 34px;
    letter-spacing: -0.5px;
    line-height: 1.1;
  }
  .how {
    margin: 8px 0 20px;
    font-size: 17px;
    color: var(--paper-ink);
  }
  code {
    font-weight: 700;
    background: #ede0c8;
    padding: 1px 6px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 48px;
    border: 3px solid var(--bg);
    padding: 0 14px;
    font: inherit;
    font-family: var(--mono);
    font-size: 17px;
    background: var(--white-ish);
    color: var(--bg);
  }
  button {
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-weight: 700;
    font-size: 16px;
    border: 3px solid var(--bg);
    background: var(--white-ish);
    color: var(--bg);
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  button:hover {
    transform: translateY(-2px);
  }
  .row button,
  button[aria-pressed='true'] {
    background: var(--bg);
    color: var(--yellow);
  }
  .row button {
    min-height: 48px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .verdict {
    margin-top: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    border: 3px solid var(--bg);
    animation: pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .verdict[hidden] {
    display: none;
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  .verdict[data-kind='ok'] { background: #ddf2c9; color: #4f8a26; }
  .verdict[data-kind='bad'] { background: #ffd9c7; color: var(--orange); }
  .verdict[data-kind='eol'] { background: #ffe9a8; color: #c98a1c; }
  .verdict[data-kind='hint'] { background: #fff; color: var(--paper-ink); }
  .verdict :global(.ico) {
    flex: 0 0 auto;
  }
  .vt {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    color: var(--bg);
  }
  .vb {
    margin: 6px 0 0;
    font-size: 17px;
    color: var(--bg);
  }
  .tbl {
    margin-top: 24px;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  caption {
    text-align: left;
    font-weight: 700;
    padding-bottom: 8px;
  }
  th {
    text-align: left;
    padding: 8px 10px 8px 0;
    border-bottom: 3px solid var(--bg);
  }
  td {
    padding: 10px 10px 10px 0;
    border-bottom: 1px solid var(--paper-line);
    color: var(--paper-ink);
    vertical-align: top;
  }
  td:first-child {
    font-weight: 700;
    color: var(--bg);
  }
  td code {
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .checker {
      padding: 22px 18px;
      box-shadow: 6px 6px 0 var(--yellow);
    }
    h2 {
      font-size: 28px;
    }
  }
</style>
