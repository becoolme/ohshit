---
interface Props {
  id: string;
  items: { title: string; hint?: string }[];
  editUrl: string;
}
const { id, items, editUrl } = Astro.props;
---

<aside class="list" aria-labelledby="wipe-title" data-checklist={id}>
  <p class="eyebrow">Wipe guide</p>
  <h2 id="wipe-title" class="disp">The wipe checklist</h2>
  <p class="count" aria-live="polite"><span data-done>0</span> of {items.length} sheets used</p>
  <div class="track" role="progressbar" aria-label="Checklist progress" aria-valuemin="0" aria-valuemax={items.length} aria-valuenow="0">
    <div class="fill" data-bar></div>
  </div>
  <ul>
    {
      items.map((s, i) => (
        <li>
          <label class="check">
            <input type="checkbox" data-i={i} />
            <span class="txt">
              <b>{s.title}</b>
              {s.hint && <span>{s.hint}</span>}
            </span>
          </label>
        </li>
      ))
    }
  </ul>
  <p class="clean" data-clean hidden>Squeaky clean. Wash your hands, then go watch for the next one.</p>
  <div class="share">
    <p>Pass this turd to your team</p>
    <div class="btns">
      <a class="b dark" href="/#dev">Alert me next time</a>
      <a class="b" href={`/api/v1/incidents/${id}.json`}>Get JSON</a>
      <a class="b" href={editUrl}>Fix this page</a>
    </div>
  </div>
</aside>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-checklist]')) {
    const key = `ohshit:checklist:${root.dataset.checklist}`;
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));
    let saved: number[] = [];
    try {
      saved = JSON.parse(localStorage.getItem(key) || '[]');
    } catch {}
    boxes.forEach((b, i) => (b.checked = saved.includes(i)));
    const sync = () => {
      const done = boxes.filter((b) => b.checked).length;
      root.querySelector('[data-done]')!.textContent = String(done);
      root.querySelector<HTMLElement>('[data-bar]')!.style.width = `${(done / boxes.length) * 100}%`;
      root.querySelector('[role=progressbar]')!.setAttribute('aria-valuenow', String(done));
      root.querySelector<HTMLElement>('[data-clean]')!.hidden = done !== boxes.length;
      try {
        localStorage.setItem(key, JSON.stringify(boxes.flatMap((b, i) => (b.checked ? [i] : []))));
      } catch {}
    };
    boxes.forEach((b) => b.addEventListener('change', sync));
    sync();
  }
</script>

<style>
  .list {
    background: var(--yellow);
    color: var(--bg);
    border: 4px solid var(--text);
    padding: 28px;
  }
  .list a {
    color: var(--bg);
  }
  .eyebrow {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
  }
  h2 {
    margin: 2px 0 6px;
    font-size: 34px;
    line-height: 1.1;
  }
  .count {
    margin: 0 0 14px;
    font-size: 16px;
    font-weight: 700;
  }
  .track {
    height: 14px;
    border: 3px solid var(--bg);
    background: var(--white-ish);
    margin-bottom: 20px;
  }
  .fill {
    height: 100%;
    width: 0;
    background: var(--bg);
    transition: width 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--white-ish);
    border: 3px solid var(--bg);
    padding: 12px 14px;
    min-height: 44px;
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .check:hover {
    transform: translateX(3px);
  }
  input {
    width: 22px;
    height: 22px;
    margin: 2px 0 0;
    accent-color: var(--bg);
    flex: 0 0 auto;
  }
  .txt b {
    display: block;
    font-size: 17px;
    line-height: 1.35;
  }
  .txt span {
    display: block;
    margin-top: 2px;
    font-size: 15px;
    color: var(--paper-ink);
    line-height: 1.5;
  }
  .check:has(input:checked) .txt {
    text-decoration: line-through;
    opacity: 0.6;
  }
  .clean {
    margin: 20px 0 0;
    background: var(--bg);
    color: var(--yellow);
    font-weight: 700;
    padding: 14px 16px;
    font-size: 17px;
  }
  .share {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 3px dashed var(--bg);
  }
  .share p {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 16px;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .b {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border: 3px solid var(--bg);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .b.dark {
    background: var(--bg);
    color: var(--yellow) !important;
  }
  .b:hover {
    background: var(--white-ish);
  }
  .b.dark:hover {
    background: var(--card);
  }
  @media (max-width: 640px) {
    .list {
      padding: 22px 18px;
    }
    h2 {
      font-size: 28px;
    }
  }
</style>
